{
  "name": "@magic-compare/public-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "tsx --tsconfig ../../tsconfig.base.json ../../scripts/sync-published.ts && next build && tsx --tsconfig ../../tsconfig.base.json ../../scripts/write-public-route-aliases.ts",
    "start": "serve out --listen 3001",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --config ../../eslint.config.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@magic-compare/compare-core": "workspace:*",
    "@magic-compare/content-schema": "workspace:*",
    "@magic-compare/shared-utils": "workspace:*",
    "@magic-compare/ui": "workspace:*",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "motion": "^12.43.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serve": "^14.2.4",
    "zod": "^4.4.3"
  }
}
