{
  "name": "@magic-compare/internal-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:all": "tsx scripts/dev.ts",
    "dev:bootstrap": "tsx scripts/dev.ts --seed",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --config ../../eslint.config.mjs",
    "test": "vitest run --passWithNoTests",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma generate --schema prisma/schema.prisma",
    "db:push": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} tsx prisma/init-db.ts",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@magic-compare/compare-core": "workspace:*",
    "@magic-compare/content-schema": "workspace:*",
    "@magic-compare/shared-utils": "workspace:*",
    "@magic-compare/ui": "workspace:*",
    "@mui/icons-material": "^9.3.0",
    "@mui/material": "^9.3.0",
    "@prisma/client": "^6.19.3",
    "next": "^16.3.0",
    "prisma": "^6.19.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18"
  }
}
