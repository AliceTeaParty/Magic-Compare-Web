{
  "name": "magic-compare-web",
  "private": true,
  "version": "1.9.5",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "build": "pnpm --filter @magic-compare/internal-site build && pnpm --filter @magic-compare/public-site build",
    "dev:doctor": "tsx scripts/dev-doctor.ts",
    "dev:internal": "pnpm dev:doctor internal && pnpm --filter @magic-compare/internal-site dev",
    "dev:bootstrap": "pnpm dev:doctor internal && pnpm --filter @magic-compare/internal-site dev:bootstrap",
    "dev:public": "pnpm dev:doctor public && pnpm --filter @magic-compare/public-site dev",
    "dev:all": "pnpm dev:doctor all && MAGIC_COMPARE_PUBLIC_SITE_BASE_URL=http://localhost:3001 pnpm --parallel --stream --filter @magic-compare/internal-site --filter @magic-compare/public-site dev:all",
    "debug:viewer-demo": "./scripts/debug-viewer-demo.sh",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "eslint apps packages scripts tests playwright.config.ts --config eslint.config.mjs",
    "lint:fix": "pnpm lint --fix",
    "test": "pnpm test:tooling && pnpm --recursive --if-present test",
    "test:tooling": "vitest run scripts/dev-doctor.test.ts",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs",
    "format:check:all": "prettier --check .",
    "clean": "pnpm clean:generated",
    "clean:generated": "node scripts/clean.mjs",
    "mcp:doctor": "mcp-vector-search doctor",
    "mcp:status": "mcp-vector-search status",
    "mcp:index": "mcp-vector-search index",
    "mcp:index:kg": "mcp-vector-search index kg",
    "mcp:search": "mcp-vector-search search",
    "mcp:complexity": "mcp-vector-search analyze complexity --top 20",
    "mcp:dead-code": "mcp-vector-search analyze dead-code",
    "sync:published": "tsx scripts/sync-published.ts",
    "public:export": "tsx --tsconfig apps/internal-site/tsconfig.json scripts/export-public.ts",
    "public:deploy": "tsx --tsconfig apps/internal-site/tsconfig.json scripts/deploy-public.ts",
    "docker:build:internal": "docker build --platform linux/amd64 -f docker/internal-site.Dockerfile -t magic-compare/internal-site .",
    "docker:dev:up": "docker compose -f docker-compose.yml -f docker/dev.compose.override.yml up -d --build internal-site",
    "docker:dev:down": "docker compose -f docker-compose.yml -f docker/dev.compose.override.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.yml -f docker/dev.compose.override.yml logs -f internal-site-init internal-site",
    "docker:dev:ps": "docker compose -f docker-compose.yml -f docker/dev.compose.override.yml ps -a",
    "db:generate": "pnpm --filter @magic-compare/internal-site db:generate",
    "db:push": "pnpm --filter @magic-compare/internal-site db:push",
    "db:seed": "pnpm --filter @magic-compare/internal-site db:seed",
    "postinstall": "pnpm db:generate"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": "7.29.6",
      "brace-expansion@<1.1.18": "1.1.18",
      "defu@<=6.1.4": "6.1.5",
      "esbuild@<0.28.1": "0.28.1",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "vite@>=7.0.0 <7.3.5": "7.3.5",
      "yaml@>=1.0.0 <1.10.3": "1.10.3"
    }
  },
  "dependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.23.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.119.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
